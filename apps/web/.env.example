# Copy to .env.local for local overrides, or set as a build-time environment
# variable in your hosting platform (e.g. Vercel project settings).
#
# Leave unset for local dev (uses the Vite dev-server proxy to
# http://127.0.0.1:8000) and for same-origin Docker Compose deployments
# (nginx proxies /api and /health to the api service).
#
# Set this ONLY when the frontend and backend are hosted on different
# origins, e.g. a Vercel-hosted frontend calling a Railway-hosted backend:
# VITE_API_BASE_URL=https://your-backend.up.railway.app
VITE_API_BASE_URL=
