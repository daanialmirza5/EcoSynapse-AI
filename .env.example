# Copy this file to .env in the repo root (or apps/api/.env) and adjust as needed.
# The application boots and runs the full deterministic demo with ZERO values
# set below -- every external dependency here is optional.

# --- Backend (apps/api) ---

# Local dev default: a file-based SQLite database, no server required.
# For production, use PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://ecosynapse:ecosynapse@db:5432/ecosynapse
DATABASE_URL=sqlite:///./ecosynapse.db

ENVIRONMENT=development
APP_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider. "mock" = deterministic, offline, zero-cost phrasing assistant
# (default). Set to "openai" + OPENAI_API_KEY to use an OpenAI-compatible
# chat completions endpoint for phrasing only -- it never generates
# scientific claims, evidence, or citations; those always come from the
# deterministic reasoning engine.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding provider. "hashing" = deterministic, offline, zero-cost (default).
# Set to "openai" + OPENAI_API_KEY for higher-quality embeddings.
EMBEDDING_PROVIDER=hashing
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256

# --- Frontend (apps/web) ---
# The Vite dev server proxies /api and /health to http://127.0.0.1:8000 by
# default (see apps/web/vite.config.ts); no env var is required for local dev.
