# ==============================================================================
# EcoSynapse AI - Environment Configuration Template
# Copy this file to .env in your root or apps/api/.env and configure as needed.
# Note: EcoSynapse runs fully offline with zero required external services/keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED (Core Backend & Database)
# ------------------------------------------------------------------------------
# Primary database connection string.
# For local development, SQLite is used by default: sqlite:///./ecosynapse.db
# For production (PostgreSQL), provide the connection URI:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Application execution environment (development | production | testing)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. OPTIONAL (AI Phrasing & High-Dimensional Embeddings)
# ------------------------------------------------------------------------------
# AI Provider: 'mock' (default, offline deterministic phrasing assistant)
# Set to 'openai' only if phrasing assistance via an OpenAI-compatible API is desired.
# Note: The reasoning engine, constraints, and facts remain 100% deterministic.
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding Provider: 'hashing' (default, offline deterministic hashing)
# Set to 'openai' for high-dimensional remote embeddings.
EMBEDDING_PROVIDER=hashing
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT ONLY
# ------------------------------------------------------------------------------
# Allowed origins for CORS during local multi-port development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local API route prefix
API_PREFIX=/api/v1

# In-memory rate limiting (requests per minute; 0 disables)
RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 4. PRODUCTION ONLY
# ------------------------------------------------------------------------------
# Secret key used for session signing and cryptographic validation in production.
APP_SECRET=replace_with_a_secure_random_secret_string

# Frontend backend target URL (used at build-time when frontend is deployed separately)
# Example: https://ecosynapse-api.onrender.com
VITE_API_BASE_URL=https://your-backend-api-url.onrender.com

# Explicit seed data path for containerized/isolated environments (optional)
SEED_DATA_DIR=
